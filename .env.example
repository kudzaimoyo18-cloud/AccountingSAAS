# ─── Neon Postgres ──────────────────────────────────────────────────────────
# PASTE THIS ONE.
# Vercel → project "mizan" → Settings → Environment Variables → DATABASE_URL
# → the eye icon reveals it → copy the whole postgres://... string.
# (It is the pooled Neon string; the host contains "-pooler".)
DATABASE_URL=

# ─── Better Auth (self-hosted, runs inside this app) ────────────────────────
# Already generated for you — no dashboard, no account, nothing to fetch.
# Users are stored in your own Neon database.
BETTER_AUTH_SECRET=
# Leave BETTER_AUTH_URL unset in development (the port varies); set it to the
# real site URL in production.
# BETTER_AUTH_URL=https://your-app.vercel.app

# ─── Cloudflare R2 (document + receipt storage) ─────────────────────────────
# Cloudflare dashboard -> R2. The account id is in the dashboard URL.
R2_ACCOUNT_ID=
R2_BUCKET=

# PASTE THESE TWO.
# R2 shows a token's secret only once, so the existing "Mizan" token cannot be
# read back. Unless you saved it somewhere, create a fresh one:
#   Cloudflare → R2 Object Storage → API → "Create Account API token"
#   → Permission: Object Read & Write → Create
#   → copy "Access Key ID" and "Secret Access Key" from the result screen.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── Anthropic ──────────────────────────────────────────────────────────────
# PASTE THIS ONE.
# It already exists in Vercel but is marked sensitive, so it cannot be revealed.
# Reuse your saved key, or make a new one at console.anthropic.com → API keys.
# Without it the app still runs: bookkeeping falls back to the rules engine.
ANTHROPIC_API_KEY=

# ─── Google sign-in (optional) ──────────────────────────────────────────────
# Leave blank and the login page shows email + password only — no dead button.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorised redirect URI must be exactly:
#   https://<your-domain>/api/auth/callback/google
# plus http://localhost:3320/api/auth/callback/google for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
