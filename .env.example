# Supabase — persists the waitlist + the books. Required for the portal/books:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — OPTIONAL. Enables the Claude AI categorisation pass for
# low-confidence bank lines. Without it, Mizan falls back to its rules engine
# (the app still works fully). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
