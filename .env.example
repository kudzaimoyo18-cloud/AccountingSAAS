# Supabase — persists the waitlist + the books. Required for the portal/books:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — powers the AI categorisation pass for the client books AND the
# admin AI ledger (reads documents into draft accounting lines). Without it,
# bookkeeping falls back to the rules engine. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
